        '      " GROUP BY INVOICE_REF_NO, INVOICE_DATE"

        'cmd1 = "SELECT DISTINCT INVOICE_REF_NO, INVOICE_DATE, SUM(TA)TA,SUM(TDS)TDS,ROUND(SUM(BASE_AMOUNT),2) BASE_AMOUNT,ROUND(SUM(BASIC_AMOUNT),2) BASIC_AMOUNT,SUM(CGST_RATE) CGST_RATE,SUM(SGST_RATE)SGST_RATE,SUM(IGST_RATE)IGST_RATE, " &
