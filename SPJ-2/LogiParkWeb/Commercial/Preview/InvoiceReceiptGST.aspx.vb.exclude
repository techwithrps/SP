        ' UPPER COMMENT BY LALIT ON 23/07/2018
        'cmd1 = "SELECT DISTINCT INVOICE_REF_NO, INVOICE_DATE, SUM(TA)TA,SUM(TDS)TDS,SUM(BASE_AMOUNT)BASE_AMOUNT,SUM(BASIC_AMOUNT)BASIC_AMOUNT,SUM(CGST_RATE) CGST_RATE,SUM(SGST_RATE)SGST_RATE,SUM(IGST_RATE)IGST_RATE," &
        '      " SUM(CGST_AMOUNT)CGST_AMOUNT,SUM(SGST_AMOUNT)SGST_AMOUNT,SUM(IGST_AMOUNT)IGST_AMOUNT FROM" &
