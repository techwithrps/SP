        '       " (TA/(100+CGST_RATE+SGST_RATE+IGST_RATE)*100)-SUM(TDS) BASIC_AMOUNT, " &
        '       "CGST_RATE,CGST_AMOUNT, SGST_RATE, SGST_AMOUNT, IGST_RATE, IGST_AMOUNT FROM  " &
        '       "(SELECT INVOICE_NO, SUM(CR_AMOUNT)TA,CASE WHEN CGST_AMOUNT >0 THEN ((SUM(CR_AMOUNT))*100/109*9/100) Else 0 End CGST_AMOUNT," &
        '     " CASE WHEN SGST_AMOUNT >0 THEN ((SUM(CR_AMOUNT))*100/109*9/100) ELSE 0 END SGST_AMOUNT, " &
