        '       "SUM(CGST_AMOUNT)CGST_AMOUNT,SUM(SGST_AMOUNT)SGST_AMOUNT,SUM(IGST_AMOUNT)IGST_AMOUNT FROM(SELECT II.INVOICE_REF_NO ,TA,SUM(TDS) TDS,((TA/(100+CGST_RATE+SGST_RATE+IGST_RATE))*100)+IGST_AMOUNT+SGST_AMOUNT+CGST_AMOUNT-SUM(TDS) BASE_AMOUNT, " &
        '       " (TA/(100+CGST_RATE+SGST_RATE+IGST_RATE)*100)-SUM(TDS) BASIC_AMOUNT, " &
