        '       "(SELECT FD.INVOICE_NO,0 CGST_RATE,CR_AMOUNT,0 CGST_AMOUNT,0 SGST_RATE,0 SGST_AMOUNT,0 IGST_RATE,0 IGST_AMOUNT,FD.REMARKS  " &
        '       "FROM PAYMENT_DETAILS PD,FINANCE_DETAILS FD WHERE  PD.RECEIPT_NO=" & lngReceiptNo & " AND FD.RECEIPT_NO=PD.RECEIPT_NO)P " &
